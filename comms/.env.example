# Copy to comms/.env (not laptop/.env); never submit real credentials.
# Laptop broker host; Ultra96 uses the broker laptop's Tailscale IP.
BROKER_HOST=localhost
# Omit CA_CERTS_PATH to use comms/broker/certs/ca.crt.
# For a remote deployment, use an absolute path:
# CA_CERTS_PATH=/absolute/path/to/ca.crt

USER_LAPTOP_CLI=laptop_cli
PW_LAPTOP_CLI=replace_with_laptop_password
# Used on Ultra96 only:
USER_ULTRA96=ultra96
PW_ULTRA96=replace_with_ultra96_password
